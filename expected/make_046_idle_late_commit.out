-- an idle pg_work takes a task committed long after the wake-up its insert sent, before the commit, which it went idle without seeing: it waits no longer than idle passes would take (pg_work.idle of the entry's role set to 1, for it to go idle after a single empty pass)
SET client_min_messages = warning;
CREATE ROLE task_idle_late SUPERUSER LOGIN;
RESET client_min_messages;
ALTER ROLE task_idle_late SET pg_work.idle = 1;
SELECT current_setting('pg_task.json') AS json_baseline
\gset
SELECT left(:'json_baseline', -1) || ',{"data":"' || :'DBNAME' || '","user":"task_idle_late","schema":"idle_late_schema"}]' AS json_val
\gset
ALTER SYSTEM SET pg_task.json = :'json_val';
SELECT pg_reload_conf();
 pg_reload_conf 
----------------
 t
(1 row)

DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        PERFORM pg_stat_clear_snapshot();
        IF EXISTS (SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'idle_late_schema' AND c.relname = 'task') AND EXISTS (SELECT 1 FROM pg_catalog.pg_stat_activity a WHERE application_name LIKE 'pg_work idle_late_schema task %' AND datname = current_database() AND state = 'idle' AND CASE WHEN current_setting('server_version_num')::int < 100000 THEN a.query LIKE 'WITH %' OR a.query LIKE 'SELECT COALESCE(LEAST(%' ELSE to_json(a) ->> 'wait_event_type' = 'Extension' END) THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for the pg_work worker of idle_late_schema.task to become idle'; END IF;
END;$body$ LANGUAGE plpgsql;
BEGIN;
INSERT INTO idle_late_schema.task (input) VALUES ('SELECT 1 AS a');
SELECT pg_sleep(3);
 pg_sleep 
----------
 
(1 row)

COMMIT;
DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..150 LOOP
        IF NOT EXISTS (SELECT 1 FROM idle_late_schema.task WHERE state NOT IN ('DONE', 'GONE', 'FAIL')) THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 150 x pg_sleep(0.1) waiting for the task of idle_late_schema.task to finish'; END IF;
END;$body$ LANGUAGE plpgsql;
SELECT state, output FROM idle_late_schema.task;
 state | output 
-------+--------
 DONE  | 1
(1 row)

ALTER SYSTEM SET pg_task.json = :'json_baseline';
SELECT pg_reload_conf();
 pg_reload_conf 
----------------
 t
(1 row)

DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        PERFORM pg_stat_clear_snapshot();
        IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_stat_activity WHERE usename = 'task_idle_late') THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for backend(s) connected as role ''task_idle_late'' to disconnect'; END IF;
END;$body$ LANGUAGE plpgsql;
SET client_min_messages TO WARNING;
DROP SCHEMA idle_late_schema CASCADE;
RESET client_min_messages;
DROP ROLE task_idle_late;
