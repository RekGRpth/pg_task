 FAIL
(1 row)

DROP TRIGGER reset_other_log ON task;
DROP FUNCTION reset_other_log();
DROP TABLE reset_other_log;
DELETE FROM task WHERE "group" = 'reset_other';
ALTER SYSTEM SET pg_task.json = :'json_baseline';
SELECT pg_reload_conf();
 pg_reload_conf 
----------------
 t
(1 row)

DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        PERFORM pg_stat_clear_snapshot();
        IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_stat_activity WHERE usename = 'reset_other') THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for the pg_work of role reset_other to stop'; END IF;
END;$body$ LANGUAGE plpgsql;
DROP ROLE reset_other;
