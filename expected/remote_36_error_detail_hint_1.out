DELETE FROM task WHERE "group" = 'error_detail_hint';
SELECT quote_literal(CURRENT_TIMESTAMP) AS ct
\gset
INSERT INTO task ("group", input, remote) VALUES ('error_detail_hint', $task$DO $inner$ BEGIN RAISE EXCEPTION 'boom' USING DETAIL = 'detail text', HINT = 'hint text'; END $inner$;$task$, 'dbname=' || :'DBNAME');
DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..150 LOOP
        IF (SELECT count(*) FROM task WHERE "group" = 'error_detail_hint' AND state NOT IN ('DONE', 'GONE', 'FAIL')) = 0 THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 150 x pg_sleep(0.1) waiting for task group ''error_detail_hint'' to finish (leave PLAN/TAKE/WORK)'; END IF;
END;$body$ LANGUAGE plpgsql;
SELECT output, error, state FROM task WHERE "group" = 'error_detail_hint' AND plan > :ct::timestamp;
 output |                                                       error                                                        | state 
--------+--------------------------------------------------------------------------------------------------------------------+-------
        | ERROR:  boom                                                                                                      +| FAIL
        | DETAIL:  detail text                                                                                              +| 
        | HINT:  hint text                                                                                                  +| 
        | STATEMENT:  DO $inner$ BEGIN RAISE EXCEPTION 'boom' USING DETAIL = 'detail text', HINT = 'hint text'; END $inner$; | 
(1 row)

