DELETE FROM task WHERE "group" = 'copy_from_stdin';
SELECT quote_literal(CURRENT_TIMESTAMP) AS ct
\gset
INSERT INTO task ("group", input) VALUES ('copy_from_stdin', 'COPY task FROM STDIN');
DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..30 LOOP
        IF (SELECT count(*) FROM task WHERE "group" = 'copy_from_stdin' AND state NOT IN ('DONE', 'GONE', 'FAIL')) = 0 THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 30 x pg_sleep(1) waiting for task group ''copy_from_stdin'' to finish (leave PLAN/TAKE/WORK)'; END IF;
END;$body$ LANGUAGE plpgsql;
SELECT "group", input, output, error, state FROM task WHERE "group" = 'copy_from_stdin' AND plan > :ct::timestamp;
      group      |        input         | output |                  error                   | state 
-----------------+----------------------+--------+------------------------------------------+-------
 copy_from_stdin | COPY task FROM STDIN |        | ERROR:  COPY FROM STDIN is not supported+| FAIL
                 |                      |        | STATEMENT:  COPY task FROM STDIN         | 
(1 row)

