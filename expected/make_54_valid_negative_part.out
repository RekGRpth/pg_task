\set VERBOSITY default
DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        IF EXISTS (SELECT 1 FROM task WHERE "group" = 'valid_negative_part_legacy' AND parent IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM task WHERE "group" = 'valid_negative_part_legacy' AND state IN ('TAKE', 'WORK')) THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for the task in group ''valid_negative_part_legacy'' to be done and repeated'; END IF;
END;$body$ LANGUAGE plpgsql;
