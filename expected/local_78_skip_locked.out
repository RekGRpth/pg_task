-- a task expired while someone else holds its row is left for a later pass, rather than pg_work wait for it to go GONE, taking no other task meanwhile
DELETE FROM task WHERE "group" LIKE 'skip_locked_%';
INSERT INTO task ("group", input, plan, active) VALUES ('skip_locked_x', 'SELECT 1', now() + interval '2 sec', '1 sec');
INSERT INTO task ("group", input) VALUES ('skip_locked_a', 'SELECT 1 FROM task WHERE "group" = ''skip_locked_x'' FOR UPDATE; SELECT pg_sleep(8)');
DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        IF EXISTS (SELECT 1 FROM task WHERE "group" = 'skip_locked_a' AND state = 'WORK') THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for the task in group ''skip_locked_a'' to start'; END IF;
END;$body$ LANGUAGE plpgsql;
SELECT pg_sleep(4);
 pg_sleep 
----------
 
(1 row)

INSERT INTO task ("group", input) VALUES ('skip_locked_b', 'SELECT 2');
DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        IF NOT EXISTS (SELECT 1 FROM task WHERE "group" LIKE 'skip_locked_%' AND state NOT IN ('DONE', 'GONE', 'FAIL')) THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for task groups ''skip_locked_%%'' to finish (leave PLAN/TAKE/WORK)'; END IF;
END;$body$ LANGUAGE plpgsql;
SELECT "group", CASE WHEN "group" = 'skip_locked_x' AND state IN ('GONE', 'DONE') THEN 'GONE or DONE' ELSE state::text END AS state, CASE WHEN "group" = 'skip_locked_b' THEN current_setting('server_version_num')::int < 90500 OR start - plan < interval '2 sec' END AS in_time FROM task WHERE "group" LIKE 'skip_locked_%' ORDER BY "group";
     group     |    state     | in_time 
---------------+--------------+---------
 skip_locked_a | DONE         | 
 skip_locked_b | DONE         | t
 skip_locked_x | GONE or DONE | 
