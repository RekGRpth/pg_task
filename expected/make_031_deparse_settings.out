-- settings that change how expressions are deparsed (IntervalStyle, quote_all_identifiers), here those of pg_work's role, don't keep the self-provisioning from recognizing what it made: no duplicate constraints or indexes on restarts, no failure on them
SELECT current_setting('pg_task.json') AS json_baseline
\gset
SET client_min_messages = warning;
CREATE ROLE deparse_settings_test SUPERUSER LOGIN;
RESET client_min_messages;
ALTER ROLE deparse_settings_test SET IntervalStyle = 'iso_8601';
ALTER ROLE deparse_settings_test SET quote_all_identifiers = on;
ALTER SYSTEM SET pg_work.restart = 2;
SELECT left(:'json_baseline', -1) || ',{"data":"' || :'DBNAME' || '","user":"deparse_settings_test","schema":"dps_schema","table":"dps"}]' AS json_val
\gset
ALTER SYSTEM SET pg_task.json = :'json_val';
SELECT pg_reload_conf();
 pg_reload_conf 
----------------
 t
(1 row)

DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        PERFORM pg_stat_clear_snapshot();
        IF EXISTS (SELECT 1 FROM pg_catalog.pg_stat_activity a WHERE application_name LIKE 'pg_work dps_schema dps %' AND datname = current_database() AND state = 'idle' AND CASE WHEN current_setting('server_version_num')::int < 100000 THEN a.query LIKE 'WITH %' OR a.query LIKE 'SELECT COALESCE(LEAST(%' ELSE to_json(a) ->> 'wait_event_type' = 'Extension' END) THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for the pg_work of dps_schema.dps to be idle'; END IF;
END;$body$ LANGUAGE plpgsql;
SELECT pid AS work_pid FROM pg_catalog.pg_stat_activity WHERE application_name LIKE 'pg_work dps_schema dps %' AND datname = current_database()
\gset
SELECT set_config('pg_task_test.work_pid', :'work_pid', false) IS NOT NULL AS work_pid_saved;
 work_pid_saved 
----------------
 t
(1 row)

SELECT pg_terminate_backend(:work_pid) AS work_terminated;
 work_terminated 
-----------------
 t
(1 row)

DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        PERFORM pg_stat_clear_snapshot();
        IF EXISTS (SELECT 1 FROM pg_catalog.pg_stat_activity a WHERE application_name LIKE 'pg_work dps_schema dps %' AND datname = current_database() AND pid <> current_setting('pg_task_test.work_pid')::int AND state = 'idle' AND CASE WHEN current_setting('server_version_num')::int < 100000 THEN a.query LIKE 'WITH %' OR a.query LIKE 'SELECT COALESCE(LEAST(%' ELSE to_json(a) ->> 'wait_event_type' = 'Extension' END) THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for the pg_work of dps_schema.dps to be idle'; END IF;
END;$body$ LANGUAGE plpgsql;
SELECT pid AS work_pid FROM pg_catalog.pg_stat_activity WHERE application_name LIKE 'pg_work dps_schema dps %' AND datname = current_database()
\gset
SELECT set_config('pg_task_test.work_pid', :'work_pid', false) IS NOT NULL AS work_pid_saved;
