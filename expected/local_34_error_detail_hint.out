DELETE FROM task WHERE "group" = 'error_detail_hint';
SELECT quote_literal(CURRENT_TIMESTAMP) AS ct
\gset
INSERT INTO task ("group", input) VALUES ('error_detail_hint', $task$DO $inner$ BEGIN RAISE EXCEPTION 'boom' USING DETAIL = 'detail text', HINT = 'hint text'; END $inner$;$task$);
DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..15 LOOP
        IF (SELECT count(*) FROM task WHERE "group" = 'error_detail_hint' AND state NOT IN ('DONE', 'GONE', 'FAIL')) = 0 THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 15 x pg_sleep(1) waiting for task group ''error_detail_hint'' to finish (leave PLAN/TAKE/WORK)'; END IF;
END;$body$ LANGUAGE plpgsql;
SELECT output, error, state FROM task WHERE "group" = 'error_detail_hint' AND plan > :ct::timestamp;
 output |                                                       error                                                        | state 
--------+--------------------------------------------------------------------------------------------------------------------+-------
        | ERROR:  boom                                                                                                      +| FAIL
        | DETAIL:  detail text                                                                                              +| 
        | HINT:  hint text                                                                                                  +| 
        | CONTEXT:  PL/pgSQL function inline_code_block line 1 at RAISE                                                     +| 
        | STATEMENT:  DO $inner$ BEGIN RAISE EXCEPTION 'boom' USING DETAIL = 'detail text', HINT = 'hint text'; END $inner$; | 
(1 row)

