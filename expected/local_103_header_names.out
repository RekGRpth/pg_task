      |       | 1       2       | 
 1033 | DONE  | x       y      +| 
      |       | 1       2       | 
 1034 | DONE  | x       y      +| 
      |       | 1       2       | 
 1035 | DONE  | column1 column2+| 
      |       | 1       2      +| 
      |       | 3       4       | 
 1036 | DONE  | a       b      +| 
      |       | 1       2       | 
(6 rows)

DELETE FROM task WHERE "group" = 'header_names';
DROP VIEW header_names_v;
DROP TABLE header_names_t;
