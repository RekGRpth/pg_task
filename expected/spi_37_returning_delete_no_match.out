DELETE FROM task WHERE "group" = 'returning_delete_no_match';
SELECT quote_literal(CURRENT_TIMESTAMP) AS ct
\gset
INSERT INTO task ("group", input) VALUES ('returning_delete_no_match', 'DELETE FROM returning_probe WHERE val = 99 RETURNING id');
DO $body$ BEGIN
    FOR i IN 1..15 LOOP
        IF (SELECT count(*) FROM task WHERE "group" = 'returning_delete_no_match' AND state NOT IN ('DONE', 'GONE', 'FAIL')) = 0 THEN EXIT; END IF;
        PERFORM pg_sleep(1);
    END LOOP;
END;$body$ LANGUAGE plpgsql;
SELECT "group", output, error, state FROM task WHERE "group" = 'returning_delete_no_match' AND plan > :ct::timestamp;
           group           |       output       | error | state 
---------------------------+--------------------+-------+-------
 returning_delete_no_match | DELETE_RETURNING 0 |       | DONE
