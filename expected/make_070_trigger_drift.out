DROP TRIGGER trigger_drift_result ON trigger_drift_schema.trigger_drift;
CREATE FUNCTION trigger_drift_schema.my_result() RETURNS trigger LANGUAGE plpgsql AS $function$BEGIN RETURN NEW; END;$function$;
CREATE TRIGGER trigger_drift_result AFTER INSERT ON trigger_drift_schema.trigger_drift FOR EACH ROW EXECUTE PROCEDURE trigger_drift_schema.my_result();
SELECT pid AS work_pid FROM pg_catalog.pg_stat_activity WHERE application_name LIKE 'pg_work trigger_drift_schema trigger_drift %' AND datname = current_database()
