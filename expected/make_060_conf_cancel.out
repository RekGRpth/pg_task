-- a cancel of pg_conf, of pg_cancel_backend() or of a statement_timeout, only wakes it up: pg_conf stays, rather than go down till its pg_conf.restart, and an entry whose CREATE DATABASE takes longer than the statement_timeout of the server is started still
SELECT pid AS conf_pid FROM pg_catalog.pg_stat_activity WHERE application_name = 'pg_conf'
\gset
SELECT pg_cancel_backend(:conf_pid) AS cancelled;
 cancelled 
-----------
