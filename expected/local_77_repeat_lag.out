-- the next plan of a repeating task long behind, a tiny repeat say, is found in no time and with no memory to speak of, rather than repeat by repeat for every one missed, with interrupts held off: past now, at most a repeat on, on the beat of the plan still
DELETE FROM task WHERE "group" = 'repeat_lag';
INSERT INTO task ("group", input, plan, repeat) VALUES ('repeat_lag', 'SELECT 1', date_trunc('second', now()) - interval '1 year' + interval '0.25 sec', '1 sec');
DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        IF EXISTS (SELECT 1 FROM task WHERE "group" = 'repeat_lag' AND state = 'DONE') THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for the task in group ''repeat_lag'' to be done'; END IF;
END;$body$ LANGUAGE plpgsql;
SELECT count(*) AS next, bool_and(t.plan > d.stop AND t.plan <= d.stop + interval '2 sec') AS within_a_repeat, bool_and(extract(microseconds FROM t.plan)::int % 1000000 = 250000) AS on_the_beat FROM task AS t, (SELECT stop FROM task WHERE "group" = 'repeat_lag' AND state = 'DONE') AS d WHERE t."group" = 'repeat_lag' AND t.state = 'PLAN';
 next | within_a_repeat | on_the_beat 
------+-----------------+-------------
    1 | t               | t
(1 row)

DELETE FROM task WHERE "group" = 'repeat_lag';
