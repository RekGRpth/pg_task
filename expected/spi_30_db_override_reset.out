DO $body$ BEGIN
    FOR i IN 1..120 LOOP
        IF (SELECT state FROM task WHERE "group" = 'db_override_reset') = 'DONE' THEN EXIT; END IF;
        PERFORM pg_sleep(1);
    END LOOP;
END;$body$ LANGUAGE plpgsql;
ALTER DATABASE :DBNAME RESET pg_task.reset;
SELECT pg_reload_conf();
 pg_reload_conf 
