-- an idle pg_work waits for the next task planned, in milliseconds rounded up, not seconds rounded either way, and then for a pass that's due too: no task planned a fraction of a second after a whole one is left waiting past its plan, for no pass to take it (pg_work.idle of the entry's role set to 1, for it to go idle after a single empty pass)
SET client_min_messages = warning;
CREATE ROLE task_idle_planned SUPERUSER LOGIN;
RESET client_min_messages;
ALTER ROLE task_idle_planned SET pg_work.idle = 1;
SELECT current_setting('pg_task.json') AS json_baseline
\gset
SELECT left(:'json_baseline', -1) || ',{"data":"' || :'DBNAME' || '","user":"task_idle_planned","schema":"idle_planned_schema"}]' AS json_val
\gset
ALTER SYSTEM SET pg_task.json = :'json_val';
SELECT pg_reload_conf();
 pg_reload_conf 
----------------
 t
(1 row)

DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        PERFORM pg_stat_clear_snapshot();
        IF EXISTS (SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'idle_planned_schema' AND c.relname = 'task') AND EXISTS (SELECT 1 FROM pg_catalog.pg_stat_activity a WHERE application_name LIKE 'pg_work idle_planned_schema task %' AND datname = current_database() AND state = 'idle' AND CASE WHEN current_setting('server_version_num')::int < 100000 THEN a.query LIKE 'WITH %' OR a.query LIKE 'SELECT COALESCE(LEAST(%' ELSE to_json(a) ->> 'wait_event_type' = 'Extension' END) THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for the pg_work worker of idle_planned_schema.task to become idle'; END IF;
END;$body$ LANGUAGE plpgsql;
INSERT INTO idle_planned_schema.task ("group", plan, input) SELECT 'planned_' || n, clock_timestamp() + o, 'SELECT 1 AS a' FROM (VALUES (1, interval '2.2 sec'), (2, interval '2.7 sec'), (3, interval '3.3 sec'), (4, interval '3.8 sec')) AS v (n, o);
DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        IF NOT EXISTS (SELECT 1 FROM idle_planned_schema.task WHERE state NOT IN ('DONE', 'GONE', 'FAIL')) THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for the tasks of idle_planned_schema.task to finish'; END IF;
END;$body$ LANGUAGE plpgsql;
SELECT "group", state, start - plan < interval '1500 ms' AS on_time FROM idle_planned_schema.task ORDER BY "group";
   group   | state | on_time 
-----------+-------+---------
 planned_1 | DONE  | t
 planned_2 | DONE  | t
 planned_3 | DONE  | t
 planned_4 | DONE  | t
(4 rows)

ALTER SYSTEM SET pg_task.json = :'json_baseline';
SELECT pg_reload_conf();
 pg_reload_conf 
----------------
 t
(1 row)

DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        PERFORM pg_stat_clear_snapshot();
        IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_stat_activity WHERE usename = 'task_idle_planned') THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for backend(s) connected as role ''task_idle_planned'' to disconnect'; END IF;
END;$body$ LANGUAGE plpgsql;
SET client_min_messages TO WARNING;
DROP SCHEMA idle_planned_schema CASCADE;
RESET client_min_messages;
DROP ROLE task_idle_planned;
