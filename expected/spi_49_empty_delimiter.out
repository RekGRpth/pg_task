-- an empty delimiter joins the columns with none in between, in every mode, as an empty quote or escape means none, rather than a NUL byte ending the output right there
DELETE FROM task WHERE "group" = 'empty_delimiter';
\set remote NULL
INSERT INTO task ("group", delimiter, header, remote, input) VALUES ('empty_delimiter', '', true, :remote, 'SELECT 1 AS a, 2 AS b');
DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        IF (SELECT count(*) FROM task WHERE "group" = 'empty_delimiter' AND state NOT IN ('DONE', 'GONE', 'FAIL')) = 0 THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for task group ''empty_delimiter'' to finish (leave PLAN/TAKE/WORK)'; END IF;
END;$body$ LANGUAGE plpgsql;
SELECT state, output FROM task WHERE "group" = 'empty_delimiter';
 state | output 
-------+--------
 DONE  | ab    +
       | 12
(1 row)

DELETE FROM task WHERE "group" = 'empty_delimiter';
