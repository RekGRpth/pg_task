DO $body$ BEGIN
    IF current_setting('server_version_num')::int >= 170000 THEN EXECUTE format('ALTER DATABASE %I RESET transaction_timeout', current_database()); END IF;
END;$body$ LANGUAGE plpgsql;
SELECT count(pg_terminate_backend(pid)) AS work_terminated FROM pg_catalog.pg_stat_activity WHERE application_name LIKE 'pg_work public task %' AND datname = current_database();
