-- the transaction_timeout of the settings of the database, from 17 on, is for the transactions of tasks, not for those of pg_work itself, which it ended with FATAL, taking pg_work down with every remote task it runs: pg_work keeps going under one of 1 ms
DO $body$ BEGIN
    IF current_setting('server_version_num')::int >= 170000 THEN EXECUTE format('ALTER DATABASE %I SET transaction_timeout = %L', current_database(), '1ms'); END IF;
END;$body$ LANGUAGE plpgsql;
SELECT pid AS work_pid FROM pg_catalog.pg_stat_activity WHERE application_name LIKE 'pg_work public task %' AND datname = current_database()
\gset
SELECT set_config('pg_task_test.work_pid', :'work_pid', false) IS NOT NULL AS work_pid_saved;
 work_pid_saved 
----------------
 t
(1 row)

SELECT pg_terminate_backend(:work_pid) AS work_terminated;
 work_terminated 
