 9 | t
(9 rows)

DELETE FROM task WHERE "group" LIKE 'rare_command_tags%';
DROP TABLE rct_case;
SET client_min_messages = warning;
DROP VIEW rct_v, rct_w;
DROP TABLE rct_t, rct_u, rct_ctas;
RESET client_min_messages;
