DELETE FROM task WHERE "group" = 'worker_crash_recovery';
SELECT quote_literal(CURRENT_TIMESTAMP) AS ct
\gset
INSERT INTO task ("group", input) VALUES ('worker_crash_recovery', 'SELECT pg_sleep(3) AS a');
DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..150 LOOP
        IF (SELECT state FROM task WHERE "group" = 'worker_crash_recovery') = 'WORK' THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 150 x pg_sleep(0.1) waiting for task in group ''worker_crash_recovery'' to reach WORK state'; END IF;
END;$body$ LANGUAGE plpgsql;
SELECT pid AS orig_pid FROM task WHERE "group" = 'worker_crash_recovery'
\gset
SELECT count(pg_terminate_backend(:orig_pid)) > 0 AS worker_killed;
 worker_killed 
---------------
 t
(1 row)

ALTER SYSTEM SET pg_task.reset = '2 sec';
SELECT pg_reload_conf();
 pg_reload_conf 
----------------
 t
(1 row)

DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        IF (SELECT state FROM task WHERE "group" = 'worker_crash_recovery') = 'DONE' THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for task in group ''worker_crash_recovery'' to reach DONE state'; END IF;
END;$body$ LANGUAGE plpgsql;
ALTER SYSTEM RESET pg_task.reset;
SELECT pg_reload_conf();
 pg_reload_conf 
----------------
