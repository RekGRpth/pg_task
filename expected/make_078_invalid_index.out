-- an index left invalid, of a CREATE INDEX CONCURRENTLY cancelled on its way say, or a partial one, serves none of the queries of the passes: a pg_work started with no valid one over the column makes its own, rather than count the invalid one for it and leave its passes with a sequential scan
SET client_min_messages = warning;
DROP INDEX IF EXISTS task_plan_idx;
DROP INDEX IF EXISTS task_plan_invalid;
RESET client_min_messages;
CREATE INDEX task_plan_invalid ON public.task (plan);
-- what a CREATE INDEX CONCURRENTLY cancelled on its way leaves behind: made here by marking one so
UPDATE pg_catalog.pg_index SET indisvalid = false WHERE indexrelid = 'public.task_plan_invalid'::regclass;
SELECT c.relname AS invalid, i.indisvalid AS valid FROM pg_catalog.pg_index AS i JOIN pg_catalog.pg_class AS c ON c.oid OPERATOR(pg_catalog.=) i.indexrelid WHERE c.relname OPERATOR(pg_catalog.=) 'task_plan_invalid';
      invalid      | valid 
-------------------+-------
 task_plan_invalid | f
(1 row)

SELECT pid AS work_pid FROM pg_catalog.pg_stat_activity WHERE application_name LIKE 'pg_work public task %' AND datname = current_database()
\gset
SELECT set_config('pg_task_test.work_pid', :'work_pid', false) IS NOT NULL AS work_pid_saved;
 work_pid_saved 
----------------
 t
(1 row)

SELECT pg_terminate_backend(:work_pid) AS work_terminated;
 work_terminated 
-----------------
 t
(1 row)

DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..900 LOOP
        PERFORM pg_stat_clear_snapshot();
        IF EXISTS (SELECT 1 FROM pg_catalog.pg_stat_activity a WHERE application_name LIKE 'pg_work public task %' AND datname = current_database() AND pid <> current_setting('pg_task_test.work_pid')::int AND state = 'idle' AND CASE WHEN current_setting('server_version_num')::int < 100000 THEN a.query LIKE 'WITH %' OR a.query LIKE 'SELECT COALESCE(LEAST(%' ELSE to_json(a) ->> 'wait_event_type' = 'Extension' END) THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 900 x pg_sleep(0.1) waiting for the next pg_work to be idle, its making done'; END IF;
END;$body$ LANGUAGE plpgsql;
-- the invalid index no pass for one of pg_task's: its own made again
SELECT count(*) AS made FROM pg_catalog.pg_index AS i JOIN pg_catalog.pg_class AS t ON t.oid OPERATOR(pg_catalog.=) i.indrelid JOIN pg_catalog.pg_attribute AS a ON a.attrelid OPERATOR(pg_catalog.=) t.oid AND a.attnum OPERATOR(pg_catalog.=) (i.indkey)[0] WHERE t.relname OPERATOR(pg_catalog.=) 'task' AND a.attname OPERATOR(pg_catalog.=) 'plan' AND i.indisvalid AND i.indpred IS NULL;
 made 
------
    1
(1 row)

DROP INDEX task_plan_invalid;
