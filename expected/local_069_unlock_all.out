SELECT (SELECT start FROM task WHERE "group" = 'unlock_all' AND input = 'SELECT 2') >= (SELECT max(stop) FROM task WHERE "group" = 'unlock_all' AND input LIKE 'SELECT pg_advisory_unlock_all(), %') AS one_at_a_time;
 one_at_a_time 
