-- pg_advisory_unlock_all() in an input lets go of the locks of pg_task too, which tell a running task and its group by: a pg_work restarted meanwhile, which knows the task workers of the one before it but by them and by their slots, still doesn't take the task for orphaned, back to PLAN, to run it once more, and the locks are taken back after the command
DELETE FROM task WHERE "group" = 'unlock_all';
CREATE TABLE unlock_all_runs (a int);
GRANT INSERT ON unlock_all_runs TO PUBLIC;
ALTER SYSTEM SET pg_task.reset = '1 sec';
SELECT pg_reload_conf();
 pg_reload_conf 
----------------
 t
(1 row)

INSERT INTO task ("group", input) VALUES ('unlock_all', 'SELECT pg_advisory_unlock_all(), pg_sleep(6); INSERT INTO unlock_all_runs VALUES (1)');
DO $body$ DECLARE ok boolean := false; BEGIN
    FOR i IN 1..300 LOOP
        IF EXISTS (SELECT 1 FROM task WHERE "group" = 'unlock_all' AND state = 'WORK') THEN ok := true; EXIT; END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
    IF NOT ok THEN RAISE EXCEPTION 'timed out after 300 x pg_sleep(0.1) waiting for the task in group ''unlock_all'' to start'; END IF;
END;$body$ LANGUAGE plpgsql;
SELECT pg_sleep(0.5);
 pg_sleep 
----------
 
(1 row)

SELECT pid AS work_pid FROM pg_catalog.pg_stat_activity WHERE application_name LIKE 'pg_work public task %' AND datname = current_database()
\gset
SELECT set_config('pg_task_test.work_pid', :'work_pid', false) IS NOT NULL AS work_pid_saved;
